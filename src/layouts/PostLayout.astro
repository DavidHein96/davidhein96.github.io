---
import BaseLayout from "./BaseLayout.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  date: string; // ISO: YYYY-MM-DD
  categories: string[];
  description?: string;
  cover?: ImageMetadata;
  coverPosition?: string;
  headings?: Heading[];
}

const {
  title,
  date,
  categories,
  description,
  cover,
  coverPosition = "center",
  headings = [],
} = Astro.props;

const ogImage = cover ? new URL(cover.src, Astro.site).toString() : undefined;

// Only show h2 and h3 in the TOC
const tocItems = headings.filter((h) => h.depth === 2 || h.depth === 3);

// Group h3s under their parent h2
interface TocGroup {
  h2: Heading;
  children: Heading[];
}
const tocGroups: TocGroup[] = [];
for (const h of tocItems) {
  if (h.depth === 2) {
    tocGroups.push({ h2: h, children: [] });
  } else if (h.depth === 3 && tocGroups.length > 0) {
    tocGroups[tocGroups.length - 1].children.push(h);
  }
}

function formatDate(d: string): string {
  const [year, month, day] = d.split("-").map(Number);
  return new Date(year, month - 1, day).toLocaleDateString("en-US", {
    month: "long",
    year: "numeric",
  });
}
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  <div class="mx-auto max-w-7xl px-6 py-12 lg:flex lg:justify-center lg:gap-10">
    <!-- Left spacer to keep article centered when TOC is present -->
    {
      tocItems.length > 0 && (
        <div
          class="hidden shrink-0 lg:block lg:w-56 xl:w-64"
          aria-hidden="true"
        />
      )
    }

    <!-- Main article -->
    <article class="mx-auto w-full min-w-0 max-w-4xl lg:mx-0">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="mb-6 text-sm text-gray-400">
        <a href="/projects" class="transition-colors hover:text-accent"
          >&larr; All Projects</a
        >
      </nav>

      <!-- Cover image -->
      {
        cover && (
          <div class="mb-10 overflow-hidden rounded-xl shadow-sm">
            <Image
              src={cover}
              alt={title}
              class="max-h-72 w-full object-cover"
              style={`object-position: ${coverPosition}`}
            />
          </div>
        )
      }

      <!-- Header -->
      <header class="mb-10">
        <div class="mb-4 flex flex-wrap gap-1.5">
          {categories.map((cat) => <span class="tag">{cat}</span>)}
        </div>
        <h1 class="mb-3 text-3xl font-bold leading-tight text-gray-900">
          {title}
        </h1>
        <p class="text-sm text-gray-400">{formatDate(date)}</p>
      </header>

      <!-- Body -->
      <div class="prose-body">
        <slot />
      </div>
    </article>

    <!-- TOC sidebar (desktop only) -->
    {
      tocGroups.length > 0 && (
        <nav
          aria-label="Table of contents"
          class="hidden shrink-0 lg:block lg:w-56 xl:w-64"
        >
          <div class="sticky top-24">
            <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-gray-400">
              On this page
            </p>
            <ul
              class="space-y-1 border-l border-gray-100 text-sm"
              id="toc-list"
            >
              {tocGroups.map((group) => (
                <li>
                  <a
                    href={`#${group.h2.slug}`}
                    class="toc-link toc-h2 -ml-px block border-l-2 border-transparent py-0.5 pl-3 text-gray-600 transition-colors duration-150 hover:border-accent hover:text-accent"
                    data-slug={group.h2.slug}
                  >
                    {group.h2.text}
                  </a>
                  {group.children.length > 0 && (
                    <ul
                      class="toc-children max-h-0 overflow-hidden opacity-0 transition-all duration-300 ease-in-out"
                      data-parent={group.h2.slug}
                    >
                      {group.children.map((h3) => (
                        <li>
                          <a
                            href={`#${h3.slug}`}
                            class="toc-link toc-h3 -ml-px block border-l-2 border-transparent py-0.5 pl-6 text-xs text-gray-400 transition-colors duration-150 hover:border-accent hover:text-accent"
                            data-slug={h3.slug}
                          >
                            {h3.text}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </div>
        </nav>
      )
    }
  </div>

  <!-- Active heading highlight + fold script -->
  <script>
    function initToc() {
      const h2Links = document.querySelectorAll(".toc-h2");
      const allLinks = document.querySelectorAll(".toc-link");
      const childGroups = document.querySelectorAll(".toc-children");
      if (!h2Links.length) return;

      // Map each h2 slug to its DOM heading element
      const h2Slugs: string[] = [];
      const h2Els: HTMLElement[] = [];
      h2Links.forEach((link) => {
        const slug = link.getAttribute("data-slug");
        if (slug) {
          const el = document.getElementById(slug);
          if (el) {
            h2Slugs.push(slug);
            h2Els.push(el);
          }
        }
      });

      function update() {
        // Find which h2 section we're in
        let activeH2Index = 0;
        for (let i = 0; i < h2Els.length; i++) {
          if (h2Els[i].getBoundingClientRect().top <= 100) {
            activeH2Index = i;
          }
        }
        const activeH2Slug = h2Slugs[activeH2Index];

        // Find active individual link (h2 or h3)
        let activeSlug = activeH2Slug;
        allLinks.forEach((link) => {
          const slug = link.getAttribute("data-slug");
          if (slug) {
            const el = document.getElementById(slug);
            if (el && el.getBoundingClientRect().top <= 100) {
              activeSlug = slug;
            }
          }
        });

        // Expand/collapse child groups
        childGroups.forEach((group) => {
          const parent = group.getAttribute("data-parent");
          if (parent === activeH2Slug) {
            group.classList.remove("max-h-0", "opacity-0");
            group.classList.add("max-h-96", "opacity-100");
          } else {
            group.classList.add("max-h-0", "opacity-0");
            group.classList.remove("max-h-96", "opacity-100");
          }
        });

        // Highlight active link
        allLinks.forEach((link) => {
          const slug = link.getAttribute("data-slug");
          if (slug === activeSlug) {
            link.classList.add("text-accent", "border-accent", "font-medium");
            link.classList.remove(
              "border-transparent",
              "text-gray-600",
              "text-gray-400",
            );
          } else {
            link.classList.remove(
              "text-accent",
              "border-accent",
              "font-medium",
            );
            if (link.classList.contains("toc-h3")) {
              link.classList.add("border-transparent", "text-gray-400");
            } else {
              link.classList.add("border-transparent", "text-gray-600");
            }
          }
        });
      }

      window.addEventListener("scroll", update, { passive: true });
      update();
    }

    initToc();
  </script>

  <!-- Scroll-hint fade for overflowing code blocks & tables -->
  <script>
    function initScrollHints() {
      const els = document.querySelectorAll(
        ".prose-body pre, .prose-body table",
      );
      els.forEach((el) => {
        if (el.scrollWidth <= el.clientWidth) return;

        const wrapper = document.createElement("div");
        const isDark = el.tagName === "PRE";
        wrapper.className = `scroll-hint ${isDark ? "scroll-hint--dark" : "scroll-hint--light"}`;
        el.parentNode!.insertBefore(wrapper, el);
        wrapper.appendChild(el);

        el.addEventListener(
          "scroll",
          () => {
            const atEnd = el.scrollLeft + el.clientWidth >= el.scrollWidth - 4;
            wrapper.classList.toggle("scrolled-end", atEnd);
          },
          { passive: true },
        );
      });
    }
    initScrollHints();
  </script>
</BaseLayout>
