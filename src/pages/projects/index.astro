---
import type { ImageMetadata } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("posts");

// Filter out drafts in production, sort newest first
const sorted = allPosts
  .filter((post) => import.meta.env.DEV || !post.data.draft)
  .sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
  );

function formatDate(d: string): string {
  const [year, month, day] = d.split("-").map(Number);
  return new Date(year, month - 1, day).toLocaleDateString("en-US", {
    month: "long",
    year: "numeric",
  });
}
---

<BaseLayout
  title="Projects"
  description="Projects and writing by Dave Hein — data science, bioinformatics, clinical NLP, and software engineering"
>
  <div class="mx-auto max-w-5xl px-6 py-14">
    <div class="mb-10">
      <h1 class="mb-3 text-3xl font-bold text-gray-900">
        Projects &amp; Writing
      </h1>
      <p class="max-w-2xl leading-relaxed text-gray-600">
        Write-ups on research and engineering projects — the decisions,
        trade-offs, and an occasional sprinkling of philosophical takes.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        sorted.map((post) => (
          <ProjectCard
            title={post.data.title}
            date={formatDate(post.data.date)}
            categories={post.data.categories}
            description={post.data.description}
            href={post.data.draft ? undefined : `/posts/${post.slug}`}
            comingSoon={post.data.draft ?? false}
            cover={post.data.cover as ImageMetadata}
          />
        ))
      }
    </div>
  </div>
</BaseLayout>
