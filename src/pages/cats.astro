---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import cat1 from "../assets/cat1.jpeg";
import cat2 from "../assets/cat2.jpeg";
---

<BaseLayout title="My Cat Bagel" description="This is my cat Bagel.">
  <div class="max-w-2xl mx-auto px-6 py-14 text-center">
    <h1 class="text-2xl font-bold text-gray-900 mb-2">
      My Cat Bagel
    </h1>
    <p class="text-gray-500 mb-10">
      This is my cat. That's it. That's the page.
    </p>

    <div class="space-y-8">
      <Image src={cat1} alt="Tabby and white cat laying on his back licking his belly" class="rounded-xl shadow-md mx-auto" />
      <Image src={cat2} alt="Tabby and white cat posing and looking away from the camera" class="rounded-xl shadow-md mx-auto" />
    </div>
  </div>
</BaseLayout>
