---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Home"
  description="Dave Hein — Data Scientist at UT Southwestern"
>
  <!-- Hero / Bio -->
  <section class="max-w-5xl mx-auto px-6 pt-10 pb-10 md:pt-14 md:pb-12">
    <div class="flex flex-col md:flex-row items-center md:items-start gap-10">
      <!-- Avatar -->
      <div class="shrink-0">
        <div
          class="w-36 h-36 md:w-44 md:h-44 rounded-full bg-accent/10 ring-4 ring-accent/20 flex items-center justify-center shadow-sm overflow-hidden"
        >
          <img
            src="/headshot.jpeg"
            alt="Dave Hein"
            class="w-full h-full object-cover"
            onerror="this.style.display='none'; this.parentNode.querySelector('.initials').style.display='flex'"
          />
          <span
            class="initials hidden w-full h-full items-center justify-center text-3xl font-bold text-accent"
            >DH</span
          >
        </div>
      </div>

      <!-- Bio text -->
      <div class="flex-1 max-w-2xl">
        <h1
          class="text-3xl md:text-4xl font-bold text-gray-900 mb-1 tracking-tight"
        >
          Dave Hein
        </h1>
        <p class="text-accent font-medium text-base mb-7">
          Data Scientist &middot; UT Southwestern Medical Center
        </p>

        <div class="space-y-4 text-gray-700 leading-relaxed">
          <p>Hi! Welcome to my site.</p>
          <p>
            I'm a data scientist working at the intersection of messy real-world
            data, scientific questions, and systems that have to run in
            production. Most of my work involves building LLM pipelines for
            clinical NLP, designing data infrastructure, and turning complex
            research problems into usable tools.
          </p>
          <p>
            I like understanding how things work under the hood — whether that's
            a model, a pipeline, or a dataset. This site is where I share
            projects, experiments, and ideas that sit at that intersection.
          </p>
        </div>

        <!-- Links row -->
        <div class="flex flex-wrap items-center gap-4 mt-8">
          <a href="/about" class="btn-primary">About me</a>
          <a
            href="https://orcid.org/0000-0002-8625-9528"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="ORCID"
            class="text-gray-400 hover:text-[#a6ce39] transition-colors"
          >
            <svg
              class="w-5 h-5"
              viewBox="0 0 256 256"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M128 0C57.3 0 0 57.3 0 128s57.3 128 128 128 128-57.3 128-128S198.7 0 128 0zM86.3 186.2H70.9V79.1h15.4v107.1zM78.6 66.4c-5.7 0-10.3-4.6-10.3-10.3s4.6-10.3 10.3-10.3 10.3 4.6 10.3 10.3-4.6 10.3-10.3 10.3zM194.1 186.2h-15.4v-52.6c0-13.8-4.9-23.2-17.3-23.2-9.4 0-15 6.4-17.5 12.5-.9 2.2-1.1 5.2-1.1 8.3v55h-15.4c0 0 .2-89.2 0-98.4h15.4v13.9c2-3.2 5.7-7.7 13.8-7.7 0 0 .1 0 .1 0h-.1c18.4 0 37.5 12 37.5 37.8v54.4z"
              ></path>
            </svg>
          </a>
          <a
            href="https://scholar.google.com/citations?user=o8hgAgMAAAAJ&hl=en"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Google Scholar"
            class="text-gray-400 hover:text-[#4285F4] transition-colors"
          >
            <svg
              class="w-5 h-5"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                d="M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z"
              ></path>
            </svg>
          </a>
          <a
            href="https://github.com/DavidHein96"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            class="text-gray-400 hover:text-[#333] transition-colors"
          >
            <svg
              class="w-5 h-5"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.92.359.31.678.921.678 1.856 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                clip-rule="evenodd"></path>
            </svg>
          </a>
          <a
            href="https://linkedin.com/in/david-hein-utsw"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="text-gray-400 hover:text-[#0a66c2] transition-colors"
          >
            <svg
              class="w-5 h-5"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              ></path>
            </svg>
          </a>
          <a
            href="https://drive.google.com/file/d/1-hG0LbWs_FAlrGV50Poghw5XS7he_vEL/view?usp=sharing"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-medium text-gray-500 hover:text-accent transition-colors border border-gray-200 hover:border-accent px-3 py-1.5 rounded-md"
          >
            Resume (PDF)
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Projects teaser -->
  <section class="bg-gray-50 border-t border-gray-100 pt-10 pb-16">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="text-2xl font-bold text-gray-900 mb-3">
        Projects &amp; Writing
      </h2>
      <p class="text-gray-600 leading-relaxed max-w-2xl mb-8">
        Write-ups on research and engineering projects — the decisions,
        trade-offs, and an occasional sprinkling of philosophical takes.
      </p>
      <a href="/projects" class="btn-primary"> View all projects &rarr; </a>
    </div>
  </section>
</BaseLayout>
