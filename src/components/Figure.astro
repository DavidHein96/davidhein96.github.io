---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  width?: string;
  caption?: string;
}

const { src, alt, width = "100%", caption } = Astro.props;
---

<figure style={`width: ${width}; margin: 1.5rem auto;`}>
  <Image src={src} alt={alt} class="w-full rounded-lg" />
  {
    caption && (
      <figcaption class="mt-2 text-center text-sm text-gray-500">
        {caption}
      </figcaption>
    )
  }
</figure>
