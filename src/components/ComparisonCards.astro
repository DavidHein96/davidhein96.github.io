---
interface Column {
  title: string;
  items: Record<string, string>;
}

interface Props {
  columns: Column[];
}

const { columns } = Astro.props;
const features = Object.keys(columns[0].items);
const colCount = columns.length;
---

<div
  class:list={[
    "my-8 grid gap-4",
    colCount === 2 && "sm:grid-cols-2",
    colCount >= 3 && "sm:grid-cols-2 lg:grid-cols-3",
    colCount >= 4 && "sm:grid-cols-2 lg:grid-cols-4",
  ]}
>
  {
    columns.map((col) => (
      <div class="overflow-hidden rounded-xl border border-gray-200">
        <div class="bg-accent/10 px-4 py-3">
          <p class="m-0 text-sm font-semibold text-accent-dark">{col.title}</p>
        </div>
        <div class="space-y-3 px-4 py-3">
          {features.map((feature) => (
            <div>
              <p class="m-0 text-xs font-medium uppercase tracking-wide text-gray-400">
                {feature}
              </p>
              <p class="m-0 text-sm text-gray-800">{col.items[feature]}</p>
            </div>
          ))}
        </div>
      </div>
    ))
  }
</div>
