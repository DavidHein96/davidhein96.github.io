---
interface Column {
  title: string;
  items: Record<string, string>;
}

interface Props {
  columns: Column[];
}

const { columns } = Astro.props;
const features = Object.keys(columns[0].items);
const colCount = columns.length;
---

<div class:list={[
  "grid gap-4 my-8",
  colCount === 2 && "sm:grid-cols-2",
  colCount >= 3 && "sm:grid-cols-2 lg:grid-cols-3",
  colCount >= 4 && "sm:grid-cols-2 lg:grid-cols-4",
]}>
  {columns.map(col => (
    <div class="rounded-xl border border-gray-200 overflow-hidden">
      <div class="bg-accent/10 px-4 py-3">
        <p class="font-semibold text-accent-dark text-sm m-0">{col.title}</p>
      </div>
      <div class="px-4 py-3 space-y-3">
        {features.map(feature => (
          <div>
            <p class="text-xs text-gray-400 font-medium uppercase tracking-wide m-0">{feature}</p>
            <p class="text-sm text-gray-800 m-0">{col.items[feature]}</p>
          </div>
        ))}
      </div>
    </div>
  ))}
</div>
